+    def _forward_ipex(
+        self,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        cu_seqlens: torch.Tensor | None = None,
+        max_seqlen: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Input shape:
+        (batch_size x seq_len x num_heads x head_size)
+        Uses IPEX varlen_attention for XPU.
+        """
+        from einops import rearrange
+
+        from vllm._ipex_ops import ipex_ops
+
+        bsz, q_len = query.size()[:2]  
+        kv_len = key.size(1)
+        is_reshaped = query.dim() != 4
+
+        query, key, value = self.maybe_reshape_qkv_to_4d(
+            query, key, value, bsz, q_len, kv_len
+        )
+
+        # Flatten batch and sequence dimensions: (b, s, h, d) -> (b*s, h, d)
+        query = rearrange(query, "b s h d -> (b s) h d")
+        key = rearrange(key, "b s h d -> (b s) h d")
+        value = rearrange(value, "b s h d -> (b s) h d")
+
+        output = torch.empty(
+            query.shape,
+            dtype=query.dtype,
+            device=query.device)
+
+        ipex_ops.varlen_attention(
+            query,
+            key,
+            value,
+            output,
+            cu_seqlens,
+            cu_seqlens,
+            None,
+            max_seqlen,
+            max_seqlen,
+            pdropout=0.0,
+            softmax_scale=self.scale if self.scale else 1.0 / (self.head_size ** 0.5),
+            zero_tensors=False,
+            is_causal=False,
+            return_softmax=False,
+            gen_=None,
+            window_size_left=-1,
+            window_size_right=-1,
+            logits_soft_cap=-1,
+        )
+
+        # Reshape back: (b*s, h, d) -> (b, s, h, d)
+        output = rearrange(output, "(b s) h d -> b s h d", b=bsz)
+
+        if is_reshaped:
+            output = output.reshape(bsz, q_len, -1)
+        return output
+
     def forward_native(
         self,
         query: torch.Tensor,
