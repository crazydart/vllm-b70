diff --git a/vllm/distributed/parallel_state.py b/vllm/distributed/parallel_state.py
index 58c49c0..f6b6d63 100644
--- a/vllm/distributed/parallel_state.py
+++ b/vllm/distributed/parallel_state.py
@@ -463,6 +463,24 @@ class GroupCoordinator:
 
     @contextmanager
     def graph_capture(self, graph_capture_context: GraphCaptureContext | None = None):
+        from vllm.platforms import current_platform
+
+        if current_platform.is_xpu():
+            # XPU PIECEWISE graph capture: comm ops are split points (run eager),
+            # so we only need to switch to a capture stream. None of the CUDA
+            # custom-allreduce / aiter capture machinery applies on XPU.
+            if graph_capture_context is None:
+                stream = torch.xpu.Stream()
+                graph_capture_context = GraphCaptureContext(stream)
+            else:
+                stream = graph_capture_context.stream
+            curr_stream = torch.xpu.current_stream()
+            if curr_stream != stream:
+                stream.wait_stream(curr_stream)
+            with torch.xpu.stream(stream):
+                yield graph_capture_context
+            return
+
         if graph_capture_context is None:
             stream = torch.cuda.Stream()
             graph_capture_context = GraphCaptureContext(stream)
