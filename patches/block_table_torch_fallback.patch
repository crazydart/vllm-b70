+def _compute_slot_mapping_torch(
+    *,
+    num_tokens: int,
+    max_num_tokens: int,
+    query_start_loc: torch.Tensor,
+    positions: torch.Tensor,
+    block_table: torch.Tensor,
+    block_size: int,
+    slot_mapping: torch.Tensor,
+    total_cp_world_size: int,
+    total_cp_rank: int,
+    cp_kv_cache_interleave_size: int,
+    pad_id: int,
+) -> None:
+    """Pure-torch fallback for _compute_slot_mapping_kernel (vllm-b70 workaround).
+
+    See _compute_slot_mapping_kernel above for the reference semantics. This
+    fallback is used when triton-xpu is uninstalled (to dodge the SYCL
+    Backends-mismatch on BMG / oneAPI 2026.0).
+    """
+    device = positions.device
+    # Build per-token req_idx vector by searching query_start_loc.
+    # query_start_loc[r] <= token_idx < query_start_loc[r+1] => req r.
+    token_idx = torch.arange(num_tokens, device=device, dtype=torch.int64)
+    # bucketize returns r such that boundaries[r-1] <= token_idx < boundaries[r];
+    # subtract 1 to get the req idx, then clamp to [0, num_reqs-1].
+    req_idx = torch.bucketize(token_idx, query_start_loc.to(torch.int64), right=True) - 1
+    req_idx = req_idx.clamp(min=0)
+
+    pos_i64 = positions[:num_tokens].to(torch.int64)
+    virtual_block_size = block_size * total_cp_world_size
+    block_indices = pos_i64 // virtual_block_size
+    # block_table is [max_num_reqs, max_num_blocks_per_req]; gather per-token block numbers.
+    block_numbers = block_table[req_idx, block_indices].to(torch.int64)
+
+    virtual_block_offsets = pos_i64 - block_indices * virtual_block_size
+    is_local = (
+        (virtual_block_offsets // cp_kv_cache_interleave_size) % total_cp_world_size
+        == total_cp_rank
+    )
+    local_block_offsets = (
+        virtual_block_offsets // (total_cp_world_size * cp_kv_cache_interleave_size)
+    ) * cp_kv_cache_interleave_size + (
+        virtual_block_offsets % cp_kv_cache_interleave_size
+    )
+    slot_ids = block_numbers * block_size + local_block_offsets
+    slot_ids = torch.where(is_local, slot_ids, torch.full_like(slot_ids, pad_id))
+
+    slot_mapping[:num_tokens] = slot_ids
+    if max_num_tokens > num_tokens:
+        slot_mapping[num_tokens:max_num_tokens] = pad_id
